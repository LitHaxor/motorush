{
  "name": "roadbrush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RoadBrush - a Road Rash style arcade motorcycle combat racer built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
