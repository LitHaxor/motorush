# Copy to .env.local and fill from:
#   firebase apps:sdkconfig WEB --project <your-project>
#
# Not secret - these ship in the client bundle. Security comes from
# database.rules.json. Set the same keys in the Vercel dashboard for prod.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
